# Copy to `.env` for local development (do not use localhost on production hosting).

# Local backend
REACT_APP_BACKEND_URL=http://localhost:8000

# Production: set this in your frontend host dashboard (Vercel, Netlify, Emergent, etc.)
# to your Render web service URL, then redeploy. Example:
# REACT_APP_BACKEND_URL=https://your-app-name.onrender.com
